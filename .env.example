# Coinley API Configuration
# Copy this file to .env and fill in your actual values

# IMPORTANT: This project uses Vite, which requires VITE_ prefix (not REACT_APP_)

# Your Coinley API credentials (same as used in your main application)
VITE_COINLEY_API_KEY=your_api_key_here
VITE_COINLEY_API_SECRET=your_api_secret_here

# Coinley API URL (usually the same across environments)
VITE_COINLEY_API_URL=https://hub.coinley.io

# Backend API version this build targets. Defaults to v1 when unset.
# Every host in the apiBase.js allowlist must serve /api/v1/... before a build
# with this at the default is deployed. Set it to empty to fall back to the
# unversioned /api/... paths without a code change.
VITE_API_VERSION=v1

# Note: Vite environment variables are bundled at build time
# Variables prefixed with VITE_ are exposed to the client
# Make sure your API keys have appropriate permissions and restrictions
